{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jeong-jj.github.io/fukuoka-travel-plan/schemas/trip-index.schema.json",
  "title": "Trip index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultTripId", "trips"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defaultTripId": { "$ref": "#/$defs/id" },
    "trips": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tripEntry" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "tripEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "startDate", "endDate", "status", "dataPath"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" },
        "status": {
          "enum": ["planning", "upcoming", "ongoing", "completed"]
        },
        "thumbnail": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "dataPath": {
          "type": "string",
          "pattern": "^trips/[a-z0-9-]+\\.json$"
        }
      }
    }
  }
}
