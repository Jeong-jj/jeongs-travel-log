{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jeong-jj.github.io/fukuoka-travel-plan/schemas/trip.schema.json",
  "title": "Trip data v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "meta", "hero", "itinerary", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "meta": { "$ref": "#/$defs/meta" },
    "hero": { "$ref": "#/$defs/hero" },
    "itinerary": {
      "type": "array",
      "items": { "$ref": "#/$defs/day" }
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "places": {
      "type": "array",
      "items": { "$ref": "#/$defs/place" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "href": { "$ref": "#/$defs/url" },
        "kind": {
          "enum": ["official", "map", "article", "reservation", "reference"]
        }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "display": { "type": "string" }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "destination",
        "startDate",
        "endDate",
        "timezone",
        "locale",
        "travelers",
        "status",
        "tags"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "destination": { "type": "string", "minLength": 1 },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" },
        "timezone": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 2 },
        "travelers": { "type": "integer", "minimum": 1 },
        "status": {
          "enum": ["planning", "upcoming", "ongoing", "completed"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "heroFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "icon", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "icon": { "enum": ["arrival", "departure", "budget", "custom"] },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "headline", "facts"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "headline": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "seal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary"],
          "properties": {
            "primary": { "type": "string", "minLength": 1 },
            "secondary": { "type": "string" }
          }
        },
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/heroFact" }
        },
        "accommodation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "detail"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "detail": { "type": "string" },
            "address": { "type": "string" },
            "checkIn": { "type": "string" },
            "checkOut": { "type": "string" },
            "amount": { "$ref": "#/$defs/money" },
            "mapUrl": { "$ref": "#/$defs/url" }
          }
        },
        "savedMap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "href"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1 },
            "href": { "$ref": "#/$defs/url" },
            "kind": {
              "enum": ["official", "map", "article", "reservation", "reference"]
            },
            "description": { "type": "string" }
          }
        }
      }
    },
    "eventRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["planned", "visited", "skipped", "changed", "cancelled"]
        },
        "actualTimeLabel": { "type": "string" },
        "note": { "type": "string" },
        "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "photoIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        },
        "expenseIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timeLabel", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "timeLabel": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "placeId": { "$ref": "#/$defs/id" },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        },
        "sourceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeLabel": { "type": "string" },
            "description": { "type": "string" }
          }
        },
        "record": { "$ref": "#/$defs/eventRecord" }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "dateLabel", "title", "events"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/date" },
        "dateLabel": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "state": { "type": "string" },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "region": { "type": "string" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mapUrl": { "$ref": "#/$defs/url" },
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "visited": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "sourceType"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/url" },
        "publisher": { "type": "string" },
        "accessedAt": { "$ref": "#/$defs/date" },
        "sourceType": {
          "enum": ["official", "article", "blog", "map", "personal"]
        }
      }
    },
    "sectionBase": {
      "type": "object",
      "required": ["id", "type", "navLabel", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "navLabel": { "type": "string", "minLength": 1 },
        "eyebrow": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "visible": { "type": "boolean" }
      }
    },
    "cardItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        },
        "placeId": { "$ref": "#/$defs/id" },
        "sourceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "cardsSection": {
      "allOf": [
        { "$ref": "#/$defs/sectionBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "navLabel", "title", "items"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "const": "cards" },
            "navLabel": { "type": "string" },
            "eyebrow": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "visible": { "type": "boolean" },
            "items": {
              "type": "array",
              "items": { "$ref": "#/$defs/cardItem" }
            }
          }
        }
      ]
    },
    "directoryPlace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "href"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "href": { "$ref": "#/$defs/url" },
        "note": { "type": "string" },
        "placeId": { "$ref": "#/$defs/id" }
      }
    },
    "directorySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "navLabel", "title", "regions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "grouped-directory" },
        "navLabel": { "type": "string" },
        "eyebrow": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "visible": { "type": "boolean" },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "groups"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string" },
              "groups": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label", "places"],
                  "properties": {
                    "id": { "$ref": "#/$defs/id" },
                    "label": { "type": "string" },
                    "places": {
                      "type": "array",
                      "items": { "$ref": "#/$defs/directoryPlace" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "shoppingSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "navLabel", "title", "shoppingList"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "shopping" },
        "navLabel": { "type": "string" },
        "eyebrow": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "visible": { "type": "boolean" },
        "shoppingList": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "store", "item", "criteria"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "store": { "type": "string" },
              "item": { "type": "string" },
              "criteria": { "type": "string" }
            }
          }
        },
        "resourceLinks": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        },
        "benefitCallouts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "title", "description"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "benefits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "store",
              "payment",
              "minimum",
              "discount",
              "deadline",
              "href"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "store": { "type": "string" },
              "payment": { "type": "string" },
              "minimum": { "type": "string" },
              "discount": { "type": "string" },
              "deadline": { "type": "string" },
              "href": { "$ref": "#/$defs/url" },
              "note": { "type": "string" },
              "verifiedAt": { "$ref": "#/$defs/date" },
              "sourceIds": {
                "type": "array",
                "items": { "$ref": "#/$defs/id" }
              }
            }
          }
        },
        "benefitNotice": { "type": "string" }
      }
    },
    "expenseSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "navLabel", "title", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "expense-table" },
        "navLabel": { "type": "string" },
        "eyebrow": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "visible": { "type": "boolean" },
        "summary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "value"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "category", "description", "displayAmount"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "category": { "type": "string" },
              "description": { "type": "string" },
              "amount": { "$ref": "#/$defs/money" },
              "displayAmount": { "type": "string" },
              "paidBy": { "type": "string" },
              "participants": { "type": "integer", "minimum": 1 },
              "date": { "$ref": "#/$defs/date" }
            }
          }
        }
      }
    },
    "genericSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "navLabel", "title", "data"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["gallery", "map", "checklist", "journal", "table", "links"]
        },
        "navLabel": { "type": "string" },
        "eyebrow": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "visible": { "type": "boolean" },
        "data": { "type": "object" }
      }
    },
    "section": {
      "oneOf": [
        { "$ref": "#/$defs/cardsSection" },
        { "$ref": "#/$defs/directorySection" },
        { "$ref": "#/$defs/shoppingSection" },
        { "$ref": "#/$defs/expenseSection" },
        { "$ref": "#/$defs/genericSection" }
      ]
    }
  }
}
